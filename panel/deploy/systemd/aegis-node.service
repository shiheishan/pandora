[Unit]
Description=Pandora Panel Node Control Gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aegispanel
EnvironmentFile=/opt/aegispanel/deploy/.env
# 节点端发布物绑定（版本与两个架构的 SHA-256），随每次升级覆盖；放在 .env 之后，
# 发布包的值压过 .env 里可能残留的旧手填值。「-」：缺文件不阻止启动，生产模式下
# 节点接入照样 fail closed。
EnvironmentFile=-/opt/aegispanel/deploy/release-artifact.env
ExecStart=/opt/aegispanel/bin/aegis-node
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete
MemoryMax=256M
CPUQuota=60%
# 配额按 20ms 一个周期结算（缺省 100ms）：额度用完时整个进程被停到周期末，
# 周期越短单次停摆越短。0.6 核时单次停摆上限从 40–70ms 降到 8–14ms
# （5k-r3 预热登录那一分钟 public 被节流 14 秒）。systemd 242 起支持，更老的版本
# 只告警忽略这一行。
CPUQuotaPeriodSec=20ms
# Go 软上限 = MemoryMax 的 80%；撞上限时不换页、宁可重启（理由见 aegis-public.service）。
# EnvironmentFile 里同名变量会覆盖 GOMEMLIMIT。
Environment=GOMEMLIMIT=204MiB
MemorySwapMax=0
StandardOutput=append:/var/log/aegis/node.log
StandardError=append:/var/log/aegis/node.log

[Install]
WantedBy=multi-user.target

