[Unit]
Description=Pandora Panel Node Control Gateway
# 数据服务先起：PostgreSQL 的各集群（postgresql@）都排在 postgresql.service 之前；Valkey 与 Redis 两个名字都写，
# 装的是哪个就排在哪个之后（不存在的单元 systemd 不理会）。只排顺序、不拉起，数据服务重启也不连带网关
After=network-online.target postgresql.service valkey-server.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pandora
EnvironmentFile=/opt/pandora/deploy/.env
# 节点端发布物绑定（版本与两个架构的 SHA-256），随每次升级覆盖；放在 .env 之后，
# 发布包的值压过 .env 里可能残留的旧手填值。「-」：缺文件不阻止启动，生产模式下
# 节点接入照样 fail closed。
EnvironmentFile=-/opt/pandora/deploy/release-artifact.env
ExecStart=/opt/pandora/bin/aegis-node
KillSignal=SIGTERM
# 停机两段各限 AEGIS_SHUTDOWN_TIMEOUT（缺省 20 秒）：先等在途请求跑完，再 join 后台循环
# （nonce 清理）。与 public / admin 一样留 45 秒，免得流量上报事务还没提交就被 SIGKILL。
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete
# 384M（原 256M）：1000 个节点在线时重启，全部长连接与拉取同时涌进来，起来后 1–2 秒
# 内存峰值实测 294M（含套接字缓冲，w10quiet）；256M 会在启动瞬间被 OOM 杀掉、5 秒后
# 拉起再被杀，一直到节点那边退避错开为止。稳态占用不受上限影响（1000 节点约 140M）。
MemoryMax=384M
CPUQuota=60%
# 配额按 20ms 一个周期结算（缺省 100ms）：额度用完时整个进程被停到周期末，
# 周期越短单次停摆越短。0.6 核时单次停摆上限从 40–70ms 降到 8–14ms
# （5k-r3 预热登录那一分钟 public 被节流 14 秒）。systemd 242 起支持，更老的版本
# 只告警忽略这一行。
CPUQuotaPeriodSec=20ms
# Go 软上限 = MemoryMax 的 80%；撞上限时不换页、宁可重启（理由见 aegis-public.service）。
# EnvironmentFile 里同名变量会覆盖 GOMEMLIMIT。
Environment=GOMEMLIMIT=307MiB
MemorySwapMax=0
StandardOutput=append:/var/log/aegis/node.log
StandardError=append:/var/log/aegis/node.log

[Install]
WantedBy=multi-user.target

