[Unit]
Description=AegisPanel Public API Gateway
Documentation=https://github.com/aegispanel/aegis
# 数据服务先起：PostgreSQL 的各集群（postgresql@）都排在 postgresql.service 之前；Valkey 与 Redis 两个名字都写，
# 装的是哪个就排在哪个之后（不存在的单元 systemd 不理会）。只排顺序、不拉起，数据服务重启也不连带网关
After=network-online.target postgresql.service valkey-server.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pandora
EnvironmentFile=/opt/pandora/deploy/.env
ExecStart=/opt/pandora/bin/aegis-public

# NFR-001：优雅退出，让在途的支付回调与下单事务跑完再退
KillSignal=SIGTERM
# 停机两段各限 AEGIS_SHUTDOWN_TIMEOUT（缺省 20 秒）：先等在途请求跑完，再 join 后台循环。
# 45 秒留够两段之和，免得在途事务还没提交就被 SIGKILL。
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

# --- 沙箱化。ARC-002/SEC-014 的运行时对应物：
#     网关只需要监听回环端口和连数据库，不需要任何写盘或提权能力。---
User=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# 只允许 IPv4/IPv6/Unix 套接字族
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete

# 给网关设硬上限，避免与同机服务互相挤占
MemoryMax=256M
CPUQuota=60%
# 配额按 20ms 一个周期结算（缺省 100ms）：额度用完时整个进程被停到周期末，
# 周期越短单次停摆越短。0.6 核时单次停摆上限从 40–70ms 降到 8–14ms
# （5k-r3 预热登录那一分钟 public 被节流 14 秒）。systemd 242 起支持，更老的版本
# 只告警忽略这一行。
CPUQuotaPeriodSec=20ms
# Go 运行时的软上限取 MemoryMax 的 80%：逼近时 GC 加紧回收，而不是一路长到 cgroup
# 上限、被内核拿自己的匿名页去换页。口令哈希另有全局并发上限
# （AEGIS_PASSWORD_HASH_CONCURRENCY），两者一起才压得住登录潮。
# EnvironmentFile 里同名变量会覆盖这里，要调就改 .env。
Environment=GOMEMLIMIT=204MiB
# 撞上 MemoryMax 时不许换出到 swap：宁可被 OOM 杀掉、5 秒后由 systemd 拉起，
# 也不进入换页抖动。抖动期间进程活着却几乎不推进，持连接的事务卡住连接池，
# 实测是 2–3 分钟的登录 504 与订阅伪 404；重启只丢在途请求，事务由库回滚。
MemorySwapMax=0

StandardOutput=append:/var/log/aegis/public.log
StandardError=append:/var/log/aegis/public.log

[Install]
WantedBy=multi-user.target
