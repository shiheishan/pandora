[Unit]
Description=AegisPanel Public API Gateway
Documentation=https://github.com/aegispanel/aegis
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aegispanel
EnvironmentFile=/opt/aegispanel/deploy/.env
ExecStart=/opt/aegispanel/bin/aegis-public

# NFR-001：优雅退出，让在途的支付回调与下单事务跑完再退
KillSignal=SIGTERM
# 停机两段各限 AEGIS_SHUTDOWN_TIMEOUT（缺省 20 秒）：先等在途请求跑完，再 join 后台循环。
# 45 秒留够两段之和，免得在途事务还没提交就被 SIGKILL。
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

# --- 沙箱化。ARC-002/SEC-014 的运行时对应物：
#     网关只需要监听回环端口和连数据库，不需要任何写盘或提权能力。---
User=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# 只允许 IPv4/IPv6/Unix 套接字族
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete

# 内存给网关设硬上限，避免与同机服务互相挤占
MemoryMax=256M
# CPU 不设硬配额，只设争抢时的权重（缺省 100）。原先是 CPUQuota=60%：口令哈希（Argon2id）与登录潮
# 一来额度立刻用完，进程被停到周期末，哪怕整机有一半是空闲的（5k-r3 预热那一分钟被节流 1824 次、
# 共 15.4 秒；20ms 周期把单次停摆压到 8–14ms 也还是停摆）。权重只在多个服务同时抢核时才起作用：
# 门户取 50，让数据库、节点网关与 nginx 在登录潮里先拿到 2:1 的份额，空闲时门户可以用满全部核。
# 哈希并发由 AEGIS_PASSWORD_HASH_CONCURRENCY（缺省 2）限住，内存上限仍由 MemoryMax 兜底。
CPUWeight=50
# Go 运行时的软上限取 MemoryMax 的 80%：逼近时 GC 加紧回收，而不是一路长到 cgroup
# 上限、被内核拿自己的匿名页去换页。口令哈希另有全局并发上限
# （AEGIS_PASSWORD_HASH_CONCURRENCY），两者一起才压得住登录潮。
# EnvironmentFile 里同名变量会覆盖这里，要调就改 .env。
Environment=GOMEMLIMIT=204MiB
# 撞上 MemoryMax 时不许换出到 swap：宁可被 OOM 杀掉、5 秒后由 systemd 拉起，
# 也不进入换页抖动。抖动期间进程活着却几乎不推进，持连接的事务卡住连接池，
# 实测是 2–3 分钟的登录 504 与订阅伪 404；重启只丢在途请求，事务由库回滚。
MemorySwapMax=0

StandardOutput=append:/var/log/aegis/public.log
StandardError=append:/var/log/aegis/public.log

[Install]
WantedBy=multi-user.target
