[Unit]
Description=Run the Pandora panel health check every 10 minutes

[Timer]
# 相对 timer 自己被激活的时刻：安装器 enable --now 之后等 10 分钟首跑。不用 OnBootSec：安装时开机早已超过时限，
# 它会在 enable --now 的瞬间就跑一次，那时服务刚拉起，可能把「正在启动」当故障报出去
OnActiveSec=10min
OnUnitActiveSec=10min
# 错开整点：备份、证书续期都爱挑整点跑，挤在一起会让巡检把它们造成的瞬时抖动当成故障
RandomizedDelaySec=90
Persistent=true
Unit=pandora-health.service

[Install]
WantedBy=timers.target
