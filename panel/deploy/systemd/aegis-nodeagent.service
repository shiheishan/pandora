[Unit]
Description=AegisPanel Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aegis-nodeagent -c /etc/aegis-nodeagent/config.json
Restart=on-failure
RestartSec=5

# 代理进程的并发连接数远超普通服务，默认的 1024 在几百用户时就会打满，
# 表现为「随机连不上」而不是明确报错，极难排查
LimitNOFILE=1048576

# 绑定 1024 以下端口（443 等）需要这个能力，但不必给完整 root 权限
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/aegis-nodeagent

[Install]
WantedBy=multi-user.target
