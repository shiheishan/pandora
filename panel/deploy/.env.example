# 潘多拉面板（Pandora Panel）环境变量样例。
# 复制为 deploy/.env 后由运维人员或密钥系统填入随机值。
# deploy/bootstrap.sh 只配置数据库应用角色，不会生成 .env。真实 .env 永不进入版本库。

# ---------- 数据基座 ----------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aegis
POSTGRES_PORT=5433

# 仅供迁移/维护使用的高权限 DSN；不得传给任何潘多拉面板服务进程。
AEGIS_MIGRATION_DATABASE_URL=postgres://aegis:CHANGE_ME@127.0.0.1:5433/aegis?sslmode=disable

# 应用专用角色密码，用 URL-safe 随机字符串；执行迁移后运行 deploy/bootstrap.sh。
# 该值必须与下方 AEGIS_DATABASE_URL 中 aegis_app 的密码一致。
AEGIS_DB_APP_PASSWORD=CHANGE_ME

VALKEY_PASSWORD=CHANGE_ME
VALKEY_PORT=6380

# ---------- 应用 ----------
AEGIS_ENV=development
# 运行时只允许使用 NOSUPERUSER + NOBYPASSRLS 的 aegis_app。
AEGIS_DATABASE_URL=postgres://aegis_app:CHANGE_ME@127.0.0.1:5433/aegis?sslmode=disable
AEGIS_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/0

# 默认保持登录 30 天。令牌仍绑定数据库会话，后台注销/封禁会立即使其失效。
AEGIS_ACCESS_TOKEN_TTL=720h
AEGIS_REFRESH_TOKEN_TTL=720h

# 四域网关监听端口（只绑 127.0.0.1，公网由边缘网关反代 —— ARC-001/ARC-002）
AEGIS_PUBLIC_ADDR=127.0.0.1:9000
AEGIS_ADMIN_ADDR=127.0.0.1:9001
AEGIS_CLIENT_ADDR=127.0.0.1:9002
AEGIS_NODE_ADDR=127.0.0.1:9003

# 管理后台与用户后台共用 9080 边缘入口；管理端位于该高熵路径下。
# 仅允许 20-64 位 URL-safe 单路径段，不含前导斜杠。可用以下命令生成：
#   printf 'ops_%s\n' "$(openssl rand -hex 24)"
# 隐藏路径只降低扫描暴露面，不能代替管理员登录、MFA 和零信任访问控制。
# 面板的对外 HTTPS 地址。接入命令、支付回调、订阅链接都从它拼出来。
#
# 之前这一项根本不在模板里，于是每台新装的实例都用默认的
# http://127.0.0.1:9000 —— 不是 HTTPS，「接入命令」按钮一按就 500。
# 放在这里带 CHANGE_ME，安装器装完会明确提示还没填。
AEGIS_PUBLIC_BASE_URL=https://CHANGE_ME_TO_YOUR_PANEL_DOMAIN

# 是否允许在后台给套餐定价、上架（P0B 销售闸门）。
#
# 默认关闭是刻意的：定价与上架直接决定收谁的钱，授权只能在部署时给，
# 不能由任何一个请求自己决定。但在这一项存在之前，它是「永远关闭」——
# 后台建得出套餐却加不了价格，只报一句「服务暂时不可用」。
#
# 正常运营的面板应当设为 1。
AEGIS_SALES_ENABLED=1

AEGIS_ADMIN_PATH=CHANGE_ME_TO_A_RANDOM_48_CHAR_PATH

# ---------- 密钥 ----------
# 根主密钥：用于信封加密支付密钥/云凭据等高敏字段（SEC-010）。
# 生产环境必须换成 KMS/Vault 托管，此处仅供开发。32 字节 base64。
AEGIS_MASTER_KEY=CHANGE_ME

# 各域访问令牌签名密钥互不相同，保证令牌不可跨域使用（EXT-001）
AEGIS_JWT_PUBLIC_SECRET=CHANGE_ME
AEGIS_JWT_ADMIN_SECRET=CHANGE_ME
AEGIS_JWT_CLIENT_SECRET=CHANGE_ME

# 订阅配置签名用 Ed25519 私钥（CLI-004 / AGT-007），base64 seed
AEGIS_CONFIG_SIGNING_SEED=CHANGE_ME

# ---------- 加密备份 ----------
# 备份目录必须是专用的绝对路径，systemd 单元默认只允许写入该目录。
AEGIS_BACKUP_DIR=/var/backups/aegispanel
AEGIS_BACKUP_RETENTION_DAYS=14

# age recipient 是公钥，备份端只持有公钥；无 recipient 时备份脚本会拒绝运行。
AEGIS_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
# 解密身份文件必须通过独立密钥通道供应，不得放入代码包、备份目录或仓库。
AEGIS_BACKUP_AGE_IDENTITY=/etc/aegispanel/backup-age.key

# 可选 hook：只能填可执行文件的绝对路径，不能填 shell 命令或参数。
# 远程 hook 依次收到密文备份路径和 SHA256 文件路径；失败 hook 收到事件名和退出码。
# WebDAV 自动备份可设置为 /opt/aegispanel/bin/aegis-backup-webdav。
# 该程序只接收已完成 Age 加密和 SHA256 校验的文件，不会接触明文 dump。
AEGIS_BACKUP_REMOTE_HOOK=
# 恢复默认强制签名 manifest 和 WebDAV 之外的最新检查点。
# 无签名历史备份只允许在单次命令中使用精确文件名确认，不得持久写入 .env。
AEGIS_BACKUP_MANIFEST_PUBLIC_KEY=
AEGIS_BACKUP_TRUSTED_CHECKPOINT=
AEGIS_BACKUP_WEBDAV_BIN=/opt/aegispanel/bin/aegis-backup-webdav
AEGIS_BACKUP_FAILURE_HOOK=
