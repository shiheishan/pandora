# 潘多拉面板（Pandora Panel）环境变量样例。
# 本机开发：复制为 deploy/.env，把 CHANGE_ME 换成随机值，make up 按它起开发数据基座（panel/dev/docker-compose.yml）。
# 按发布包安装：install.sh 首装自己生成 deploy/.env（口令与密钥随机），不用这份样例；这里只作各键的说明。
# deploy/bootstrap.sh 只配置数据库应用角色，不会生成 .env。真实 .env 永不进入版本库。
# 口令一律用 URL-safe 随机字符串（下面的连接串里要原样出现），例如 openssl rand -hex 24。

# ---------- 数据基座 ----------
# 身份与直装一致：postgres 是超级用户（迁移、psql.sh、预检、备份恢复经 127.0.0.1:POSTGRES_PORT 以它连，
# 口令 POSTGRES_SUPER_PASSWORD）；POSTGRES_USER 是库 POSTGRES_DB 的属主（普通登录角色）；网关只用运行角色 aegis_app。
# 端口：开发数据基座映射到 5433 / 6380；直装是系统 PostgreSQL / Valkey 的端口，install.sh 写入。
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SUPER_PASSWORD=CHANGE_ME
POSTGRES_DB=aegis
POSTGRES_PORT=5433

# 仅供迁移/维护使用的超级用户 DSN（口令同 POSTGRES_SUPER_PASSWORD）；不得传给任何潘多拉面板服务进程。
AEGIS_MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5433/aegis?sslmode=disable

# 应用专用角色密码，用 URL-safe 随机字符串；执行迁移后运行 deploy/bootstrap.sh。
# 该值必须与下方 AEGIS_DATABASE_URL 中 aegis_app 的密码一致。
AEGIS_DB_APP_PASSWORD=CHANGE_ME

VALKEY_PASSWORD=CHANGE_ME
VALKEY_PORT=6380

# ---------- 应用 ----------
# 模板默认 development，给本地开发用。按发布包安装时 install.sh 首装写 production
# （并要求下方的 AEGIS_PUBLIC_BASE_URL 是 https://域名 或 https://公网IPv4）；升级不改它。
# production 下节点接入还要求 release-artifact.env 的发布物绑定（pdnd 两个架构的
# SHA-256 与版本，由 build-release.sh 随包生成）。
AEGIS_ENV=development
# 运行时只允许使用 NOSUPERUSER + NOBYPASSRLS 的 aegis_app。
AEGIS_DATABASE_URL=postgres://aegis_app:CHANGE_ME@127.0.0.1:5433/aegis?sslmode=disable
AEGIS_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/0

# 默认保持登录 30 天。令牌仍绑定数据库会话，后台注销/封禁会立即使其失效。
AEGIS_ACCESS_TOKEN_TTL=720h
AEGIS_REFRESH_TOKEN_TTL=720h

# 三个网关的监听端口（只绑 127.0.0.1，公网由边缘网关反代 —— ARC-001/ARC-002）。
AEGIS_PUBLIC_ADDR=127.0.0.1:9000
AEGIS_ADMIN_ADDR=127.0.0.1:9001
AEGIS_NODE_ADDR=127.0.0.1:9003

# pprof 诊断端口（压测与排障用，默认关闭：留空或不写即不监听）。
# 三个网关共用这一份 .env，所以每个网关一个变量、各占一个端口，不得与上面的
# 业务端口或彼此重复。只接受回环 IP 字面量（127.0.0.0/8 或 [::1]），主机名
# （含 localhost）、0.0.0.0、内网或公网地址都会让网关拒绝启动。
# 打开：填好后 systemctl restart 对应网关；在本机或经 SSH 隧道取
#   curl -o cpu.pprof 'http://127.0.0.1:6060/debug/pprof/profile?seconds=30'
# 用完清空并再次重启。pprof 能导出进程内存，绝不要经 nginx 或防火墙转发出去。
AEGIS_PUBLIC_PPROF_ADDR=
AEGIS_ADMIN_PPROF_ADDR=
AEGIS_NODE_PPROF_ADDR=

# 运行时资源上限（留空即用缺省值，设了就严格校验，越界网关拒绝启动）。
# 连接池按 deploy/postgresql-pandora.conf 的 max_connections=60 算（开发数据基座同值）：3 条超级用户保留 + 11 条维护余量 +
# public 常驻的 1 条 LISTEN + 三个网关各 15 条，所以缺省 public 16、admin 15、node 14
# （node 另有 1 条池外的纪元监听探针专用连接，LISTEN 也从它的池里借）；
# 改 max_connections 或多开网关实例时按同一个算式重排（取值 2–500）。
AEGIS_PUBLIC_DB_MAX_CONNS=
AEGIS_ADMIN_DB_MAX_CONNS=
AEGIS_NODE_DB_MAX_CONNS=
# 各网关连接池的常驻连接数（缺省 public 1、admin 1、node 8，取值 0 到对应的 MAX_CONNS；
# 只调小了 MAX_CONNS 时缺省值自动随之收）。node 常驻 8 条，免得空闲回收后下一波节点
# 请求现建连接、重做认证。连接寿命固定为 2–4 小时随机（不可配），避免同批到期。
AEGIS_PUBLIC_DB_MIN_CONNS=
AEGIS_ADMIN_DB_MIN_CONNS=
AEGIS_NODE_DB_MIN_CONNS=
# 节点端口保留表（逗号分隔，可写区间如 9000-9003）。AEGIS_NODE_RESERVED_PORTS 在任何服务器上
# 都拒绝建节点（缺省 22,25,53,80；80 预留给证书 HTTP 验证）；AEGIS_PANEL_RESERVED_PORTS 只在
# 节点所在服务器就是面板机时拒绝（缺省 80,443,5432,6379,9000-9003），判断不了时只提示；写 none 清空。
# AEGIS_PANEL_HOSTS 是面板机的域名或 IP（逗号分隔，另自动加上 AEGIS_PUBLIC_BASE_URL 的主机名），
# 用来判断「节点是不是装在面板机上」；写上面板机公网 IP 后，IP 对不上的服务器不再提示。
AEGIS_NODE_RESERVED_PORTS=
AEGIS_PANEL_RESERVED_PORTS=
AEGIS_PANEL_HOSTS=
# Argon2id 口令哈希每次约 19 MiB：同时计算的上限（缺省 1，取值 1–16；网关 CPUQuota
# 只有 0.6–0.8 核，并发 2 会让进程被节流停摆，加大前先加配额）与排队上限
# （缺省 5s，最长 15s，要短于 nginx 认证入口 20 秒的读超时）。排不上回 503。
AEGIS_PASSWORD_HASH_CONCURRENCY=
AEGIS_PASSWORD_HASH_QUEUE_TIMEOUT=
# 下发给节点的拉用户节拍，整秒（缺省 15，取值 5–300）。第三方 UniProxy 节点端不连
# 事件流，到期、配额用尽靠轮询收口，调大会拉长超额停用的延迟。
AEGIS_NODE_PULL_INTERVAL=

# 面板的对外 HTTPS 地址：https://域名 或 https://公网IPv4，不带端口与路径。接入命令、支付回调、
# 订阅链接都从它拼出来；nginx 的 server_name 与证书（edge-tls.sh：域名证书、IP 证书或自签兜底）
# 也按它的主机配。改了它要重跑安装脚本（或 deploy/edge-tls.sh setup）换证书与 nginx 配置。
#
# 之前这一项根本不在模板里，于是每台新装的实例都用默认的
# http://127.0.0.1:9000 —— 不是 HTTPS，「接入命令」按钮一按就 500。
# 放在这里带 CHANGE_ME，安装器装完会明确提示还没填。
AEGIS_PUBLIC_BASE_URL=https://CHANGE_ME_TO_YOUR_PANEL_DOMAIN

# 管理后台的高熵路径前缀：管理后台与用户门户对外经同一个 443 按域名进入，
# 管理端位于该路径下（127.0.0.1:9080 是本机回环运维入口）。
# 仅允许 20-64 位 URL-safe 单路径段，不含前导斜杠。可用以下命令生成：
#   printf 'ops_%s\n' "$(openssl rand -hex 24)"
# 隐藏路径只降低扫描暴露面，不能代替管理员登录、MFA 和零信任访问控制。
AEGIS_ADMIN_PATH=CHANGE_ME_TO_A_RANDOM_48_CHAR_PATH

# ---------- 密钥 ----------
# 根主密钥：用于信封加密支付密钥/云凭据等高敏字段（SEC-010）。
# 生产环境必须换成 KMS/Vault 托管，此处仅供开发。32 字节 base64。
AEGIS_MASTER_KEY=CHANGE_ME

# 各域访问令牌签名密钥互不相同，保证令牌不可跨域使用（EXT-001）
AEGIS_JWT_PUBLIC_SECRET=CHANGE_ME
AEGIS_JWT_ADMIN_SECRET=CHANGE_ME

# 订阅配置签名用 Ed25519 私钥（CLI-004 / AGT-007），base64 seed
AEGIS_CONFIG_SIGNING_SEED=CHANGE_ME

# ---------- 加密备份 ----------
# 备份目录必须是专用的绝对路径，systemd 单元默认只允许写入该目录。
AEGIS_BACKUP_DIR=/var/backups/pandora
AEGIS_BACKUP_RETENTION_DAYS=14

# age recipient 是公钥，备份端只持有公钥；无 recipient 时备份脚本会拒绝运行。
AEGIS_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
# 解密身份文件必须通过独立密钥通道供应，不得放入代码包、备份目录或仓库。
AEGIS_BACKUP_AGE_IDENTITY=/opt/pandora/secrets/backup-age.key

# 可选 hook：只能填可执行文件的绝对路径，不能填 shell 命令或参数。
# 远程 hook 依次收到密文备份路径和 SHA256 文件路径；失败 hook 收到事件名和退出码。
# WebDAV 自动备份可设置为 /opt/pandora/bin/aegis-backup-webdav。
# 该程序只接收已完成 Age 加密和 SHA256 校验的文件，不会接触明文 dump。
AEGIS_BACKUP_REMOTE_HOOK=
# 恢复默认强制签名 manifest 和 WebDAV 之外的最新检查点。
# 无签名历史备份只允许在单次命令中使用精确文件名确认，不得持久写入 .env。
AEGIS_BACKUP_MANIFEST_PUBLIC_KEY=
AEGIS_BACKUP_TRUSTED_CHECKPOINT=
AEGIS_BACKUP_WEBDAV_BIN=/opt/pandora/bin/aegis-backup-webdav
AEGIS_BACKUP_FAILURE_HOOK=

# ---------- sing-box 订阅模板（可选） ----------
# sing-box 订阅附带 TUN、DNS 国内外分流与基础路由，规则集用远程 rule-set。
# 缺省从 SagerNet 公开发布的 sing-geosite / sing-geoip 的 rule-set 分支下载；要换镜像时填
# https:// 开头、以 / 结尾的前缀（后面拼 geosite-cn.srs 等文件名）。
# AEGIS_SINGBOX_GEOSITE_URL_PREFIX=
# AEGIS_SINGBOX_GEOIP_URL_PREFIX=
# 按 geosite-category-ads-all 拦截广告域名（true / false，缺省 false）
# AEGIS_SINGBOX_BLOCK_ADS=false
