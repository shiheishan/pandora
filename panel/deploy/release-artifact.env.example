# 发布包 deploy/release-artifact.env 的样例；真实文件由 build-release.sh 按本包现场生成，
# install.sh 装到 /opt/pandora/release.env，只作记录（升级时打印「从哪个版本到哪个版本」）。
# pandora 运行时不读它；节点端二进制的摘要由面板按 pdnd-dist 里的文件现算。
PANDORA_RELEASE_VERSION=REPLACE_WITH_RELEASE_VERSION
PANDORA_BINARY_SHA256=REPLACE_WITH_PANDORA_BINARY_SHA256
PANDORA_NATIVE_ARTIFACT_AMD64_SHA256=REPLACE_WITH_NATIVE_AMD64_SHA256
PANDORA_NATIVE_ARTIFACT_ARM64_SHA256=REPLACE_WITH_NATIVE_ARM64_SHA256
PANDORA_GEOIP_V4_SHA256=REPLACE_WITH_GEOIP_V4_SHA256
