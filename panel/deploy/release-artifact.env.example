# 发布包 deploy/release-artifact.env 的样例，真实文件由 build-release.sh 按本包的
# pdnd-dist/ 现场生成，install.sh 装到 /opt/pandora/deploy/，
# aegis-node.service 以 EnvironmentFile= 加载。
# 生产模式（.env 的 AEGIS_ENV=production）下三项缺一即拒绝节点接入；绝不接受
# 请求里带来的摘要作为替代。运行模式不在这个文件里设置。
PANDORA_NATIVE_RELEASE_VERSION=REPLACE_WITH_RELEASE_VERSION
PANDORA_NATIVE_ARTIFACT_AMD64_SHA256=REPLACE_WITH_SHA256SUMS_AMD64
PANDORA_NATIVE_ARTIFACT_ARM64_SHA256=REPLACE_WITH_SHA256SUMS_ARM64
