# Copy the values from the exact SHA256SUMS generated with this panel release.
# In production all three values are mandatory; never accept request-supplied
# artifact hashes as a substitute.
AEGIS_ENV=production
PANDORA_NATIVE_RELEASE_VERSION=pandora-native-VERSION
PANDORA_NATIVE_ARTIFACT_AMD64_SHA256=REPLACE_WITH_SHA256SUMS_AMD64
PANDORA_NATIVE_ARTIFACT_ARM64_SHA256=REPLACE_WITH_SHA256SUMS_ARM64
