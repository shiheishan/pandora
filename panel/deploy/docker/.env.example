# Pandora 面板 Docker Compose 环境变量配置样例
#
# 推荐生成方式：
#   umask 077
#   docker run --rm -e PANDORA_PUBLIC_BASE_URL=https://panel.example.test ghcr.io/shiheishan/pandora-ops:<版本> gen-env > .env
#   chmod 600 .env
#
# 一条命令即可自动生成填好强随机秘密与私钥的 .env 文件。
# 手动填写时，必须将所有 CHANGE_ME 替换为真实值。
# 注意：.env 中包含主加密密钥与备份私钥，一旦丢失将无法解密库中加密字段与备份归档，必须在机器外部妥善另存一份！
# 切勿将 .env 提交进版本控制仓库。

# ==================== 镜像 ====================
# 镜像仓库前缀，缺省为 ghcr.io/shiheishan
PANDORA_IMAGE_REPO=ghcr.io/shiheishan
# 镜像版本标签（如 v1.2.3），升级面板时修改此项；不可保持 CHANGE_ME
PANDORA_VERSION=CHANGE_ME

# ==================== 站点 ====================
# 对外基准 URL，必须为 https:// 开头且不带尾斜杠，需为合规 DNS 域名或公网 IPv4
PANDORA_PUBLIC_BASE_URL=https://panel.example.test
# 节点连接 gRPC 对外广播主机名/IP，缺省与站点域名相同
PANDORA_GRPC_PUBLIC_HOST=panel.example.test
# 节点连接 gRPC 对外广播端口，0 表示沿用 9443；若宿主外部映射端口改变则填宿主端口
PANDORA_GRPC_PUBLIC_PORT=0
# 管理后台安全路径前缀（20~64 个 URL 安全字符，如 ops_ 后接 24 位十六进制字符）；不可保持 CHANGE_ME
PANDORA_ADMIN_PATH=CHANGE_ME

# ==================== 边缘与端口 ====================
# 宿主 HTTP 绑定端口，直出公网缺省 80
PANDORA_HTTP_PUBLISH=80
# 宿主 HTTPS 绑定端口，直出公网缺省 443
PANDORA_HTTPS_PUBLISH=443
# 宿主回环明文代理端口，供宿主运维或外部反代接入
PANDORA_LOOPBACK_PUBLISH=127.0.0.1:9080
# 宿主节点 gRPC 监听端口，面板自身终结 mTLS，缺省 9443
PANDORA_GRPC_PUBLISH=9443

# 前面已有反代（如 1Panel OpenResty / Caddy / Nginx 等）时的配置方式：
# 1. 将上面端口改为只绑回环随机端口（避免公网直接访问）：
#    PANDORA_HTTP_PUBLISH=127.0.0.1:
#    PANDORA_HTTPS_PUBLISH=127.0.0.1:
# 2. 前置反代将请求代理至 http://127.0.0.1:9080
# 3. 前置反代必须【覆写】X-Real-IP 请求头（如 proxy_set_header X-Real-IP $remote_addr;），严禁透传客户端提交的请求头
# 4. 下方的 PANDORA_REALIP_FROM 设为 gateway（注意：gateway 仅可在 80/443 未对公网发布时使用）

# ==================== 真实来源 IP ====================
# 信任的代理来源 IP/CIDR（逗号分隔），空表示不信任任何代理，仅认容器 TCP 连接对端
# 若前面有 Cloudflare，填入官方 IP 网段（见 https://www.cloudflare.com/ips-v4 与 ips-v6）
# 若前面已有宿主反代且 80/443 未对公网发布，可填 gateway 信任容器默认网关
PANDORA_REALIP_FROM=
# 提取客户端真实 IP 的请求头名称，可选 X-Real-IP 或 CF-Connecting-IP
# 前置使用 Cloudflare 时设为 CF-Connecting-IP
PANDORA_REALIP_HEADER=X-Real-IP

# ==================== 证书 ====================
# 宿主证书挂载目录，放置 fullchain.pem 与 privkey.pem；缺失时将自动生成自签证书
PANDORA_TLS_DIR=./tls
# ACME HTTP-01 挑战文件目录
PANDORA_ACME_DIR=./acme

# ==================== 秘密 ====================
# PostgreSQL 超级用户 postgres 的口令（至少 32 位 URL 安全字符：字母、数字、_、-）
POSTGRES_SUPER_PASSWORD=CHANGE_ME
# 迁移与建表属主角色 pandora_owner 的口令（至少 32 位 URL 安全字符）
PANDORA_OWNER_DB_PASSWORD=CHANGE_ME
# 业务运行时角色 pandora_app 的口令（至少 32 位 URL 安全字符）
PANDORA_APP_DB_PASSWORD=CHANGE_ME
# Redis 访问口令（至少 32 位 URL 安全字符）
PANDORA_REDIS_PASSWORD=CHANGE_ME
# 数据加密主密钥（Base64 编码，解码后至少 32 字节，用于派生存储封印密钥）
PANDORA_SECRETS_MASTER_KEY=CHANGE_ME
# 用户端 JWT 签名密钥（至少 32 字节十六进制字符）
PANDORA_AUTH_PUBLIC_JWT_SECRET=CHANGE_ME
# 管理端 JWT 签名密钥（至少 32 字节十六进制字符，必须与用户端不同）
PANDORA_AUTH_ADMIN_JWT_SECRET=CHANGE_ME

# ==================== 备份 ====================
# 数据库备份加密用 age 私钥（AGE-SECRET-KEY-1... 格式）
PANDORA_BACKUP_AGE_KEY=CHANGE_ME
# 本地备份归档保留天数，过期自动清理，缺省 14 天
PANDORA_BACKUP_RETENTION_DAYS=14
