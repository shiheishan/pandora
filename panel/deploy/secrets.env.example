# pandora 秘密样例（/etc/pandora/secrets.env，root:pandora 0640，systemd 用 EnvironmentFile= 读）。
#
# install.sh 首装时现场生成真实值（openssl rand），只写进这个文件，不出现在命令行参数和输出里；
# 升级不改它。这里只有占位符，不要把真实值写回仓库。
# 格式：KEY=VALUE，一行一个，不加引号（systemd 与部署脚本都逐行读，不当 shell 执行）。

# 运行角色 pandora_app（不是超级用户、不是表属主、没有 CREATE / TEMP）
PANDORA_DATABASE_URL=postgres://pandora_app:CHANGE_ME@127.0.0.1:5432/pandora?sslmode=disable
# Redis 只绑回环、requirepass
PANDORA_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# 根密钥：base64，解码后至少 32 字节（openssl rand -base64 32）。丢了就解不开库里封存的字段
PANDORA_SECRETS_MASTER_KEY=CHANGE_ME
# 门户与后台各一把 JWT 密钥：至少 32 字节，两把不能相同（openssl rand -hex 32）
PANDORA_AUTH_PUBLIC_JWT_SECRET=CHANGE_ME
PANDORA_AUTH_ADMIN_JWT_SECRET=CHANGE_ME
