# 本机开发环境变量样例：复制成 dev/.env（被 git 忽略），把 CHANGE_ME 换成随机值，例如 openssl rand -hex 24。
# make up 按它起开发数据基座（dev/docker-compose.yml）；make migrate / serve / worker 把它导进环境再跑 pandora；
# deploy/psql.sh 经 PANDORA_DEPLOY_ENV=dev/.env 读它（Makefile 已设好）。
# 口令用 URL-safe 随机串：下面的连接串里要原样出现，三处口令要一致。
# 生产不用这份：install.sh 现场生成 /etc/pandora/{config.yaml,secrets.env,deploy.env}。

# ---- 开发数据基座（docker compose 与 deploy/psql.sh 读）
POSTGRES_PORT=5433
POSTGRES_DB=pandora
# 超级用户 postgres 的口令（psql.sh 以它进库）
POSTGRES_SUPER_PASSWORD=CHANGE_ME
# 库属主 pandora_owner 的口令（迁移与本机运行都用它；开发模式不检查运行角色）
PANDORA_OWNER_PASSWORD=CHANGE_ME
REDIS_PORT=6380
REDIS_PASSWORD=CHANGE_ME

# ---- pandora（viper 按 PANDORA_ 前缀读，键里的点换成下划线）
PANDORA_ENV=development
PANDORA_DATABASE_URL=postgres://pandora_owner:CHANGE_ME@127.0.0.1:5433/pandora?sslmode=disable
PANDORA_DATABASE_MIGRATION_URL=postgres://pandora_owner:CHANGE_ME@127.0.0.1:5433/pandora?sslmode=disable
PANDORA_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/0
# openssl rand -base64 32
PANDORA_SECRETS_MASTER_KEY=CHANGE_ME
# 两把各 openssl rand -hex 32，不能相同
PANDORA_AUTH_PUBLIC_JWT_SECRET=CHANGE_ME
PANDORA_AUTH_ADMIN_JWT_SECRET=CHANGE_ME
