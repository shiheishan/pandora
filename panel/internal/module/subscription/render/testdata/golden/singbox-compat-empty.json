{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      }
    ],
    "servers": [
      {
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "https"
      }
    ],
    "strategy": "ipv4_only"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv4"
    },
    "final": "direct",
    "rule_set": [
      {
        "format": "binary",
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "url": "https://mirror.example.test/geosite/geosite-category-ads-all.srs"
      },
      {
        "format": "binary",
        "tag": "geosite-cn",
        "type": "remote",
        "url": "https://mirror.example.test/geosite/geosite-cn.srs"
      },
      {
        "format": "binary",
        "tag": "geoip-cn",
        "type": "remote",
        "url": "https://mirror.example.test/geoip/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "route",
        "outbound": "direct",
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ]
      }
    ]
  }
}