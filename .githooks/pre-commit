#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: 未安装 gitleaks（brew install gitleaks），拒绝提交" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
scan() { gitleaks git --pre-commit --staged --redact --no-banner --config "$1" "$root"; }

# 公开规则：内置密钥格式 + 本项目专属格式
scan "$root/.gitleaks.toml"
# 私有规则：真实服务器 IP 等，只存在于维护者本机主目录的 ops-local/（由
# ops-local/gitleaks/gen-private.sh 生成）。worktree 里没有 ops-local/，回到主仓库去找。
main_root="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
for private in "$root/ops-local/gitleaks-private.toml" "$main_root/ops-local/gitleaks-private.toml"; do
  if [[ -f "$private" ]]; then
    scan "$private"
    break
  fi
done
