# 版本控制元数据，体积大且与镜像内容无关
.git
**/.git
.github

# 本地会话、任务说明与 agent 配置，可能含本机路径，且不应进公开镜像构建
.claude
.agents

# 维护者本机运维与私有规则，含真实部署信息
ops-local

# 设计文档不参与构建
docs

# 前端与 Go 构建缓存/产物，应在镜像内由 build-release.sh 重新生成
**/node_modules
panel/frontend/dist
panel/dist
panel/bin
panel/output
pdnd/bin
pdnd/.tmp
pdnd/release/dist
pdnd/release/test-release
pdnd/pandora-native-linux-*

# 发布归档与压缩包，构建阶段自行产出
**/*.tar.gz

# 环境文件常含数据库口令与 JWT 密钥，绝不能进入构建上下文
**/.env
**/.env.local

# compose 站长本地 TLS/ACME 目录，与镜像构建无关
panel/deploy/docker/tls
panel/deploy/docker/acme

# 日志文件无构建价值，且可能泄露运行信息
**/*.log
