[Unit]
Description=Pandora NativeCore node agent
Wants=network-online.target
After=network-online.target
# 崩溃循环要看得出来：缺省 10 秒内 5 次的限制配上 RestartSec=5s 永远撞不到，进程坏了会无声地每 5 秒重启。
# 300 秒内启动 10 次（约 1 分钟持续崩溃）就停下进入 failed，systemctl status 与面板离线都能看到；
# 在线升级的助手重启前会先 reset-failed。
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pandora
Group=pandora
ExecStart=/usr/local/bin/pandora-native -c /etc/pandora-native/config.json
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/pandora-native /var/log/pandora-native
StateDirectory=pandora-native
LogsDirectory=pandora-native
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
