# 节点在线升级的 root 侧助手（只由 pandora-native-upgrade.path 触发）：用已安装的 root 属主二进制自己内置的公钥
# 验签、核摘要，替换 /usr/local/bin/pandora-native 并重启 pandora-native，在时限内等新进程连上面板，否则装回旧版。
# TimeoutStartSec 覆盖：确认时限至多 300 秒 + 两次重启（各至多 90 秒）+ 拷贝与校验。
# 加固：助手只写 /usr/local/bin、pandora 的暂存目录（属 pandora，root 要 CAP_DAC_OVERRIDE 才进得去）与自己的
# StateDirectory，再经 /run/systemd/private（文件系统里的 unix 套接字，不受 PrivateNetwork 影响）调 systemctl；
# 不联网、不 chown。暂存目录不存在时 ReadWritePaths 的 - 前缀让单元照常起（否则 226/NAMESPACE）。
# 被重启的 pandora-native 由 PID 1 按它自己的单元起，不继承这里的限制。改这里要同步面板安装器的 HELPERUNIT。
# 续做（工作区留着 applying：助手在确认窗口里被杀、崩溃或整机重启）交给 .prev 跑：那时装着的是还没确认的新版，
# 它要是一启动就崩，回退逻辑就跑不起来、节点卡在坏版本上；applying 本来就是旧版的助手写的，旧版就是 .prev。
[Unit]
Description=Pandora NativeCore upgrade helper

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c 'if [ -e /var/lib/pandora-native-upgrade/applying ] && [ -x /usr/local/bin/pandora-native.prev ]; then exec /usr/local/bin/pandora-native.prev upgrade-apply; fi; exec /usr/local/bin/pandora-native upgrade-apply'
TimeoutStartSec=600
UMask=0077
StateDirectory=pandora-native-upgrade
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin -/var/lib/pandora-native
CapabilityBoundingSet=CAP_DAC_OVERRIDE
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
